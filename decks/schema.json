{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samhvw8/thinking-skills/decks/schema.json",
  "title": "thinking-skills decks",
  "description": "One property per file in decks/: decks/<kind>.json holds the value of property <kind>. Validate one file against #/properties/<kind>. 'x-ref': <kind> marks a string that must be an id (or, for families and rubrics, a key) in decks/<kind>.json; tools/build_decks.py enforces it.",
  "type": "object",
  "properties": {
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lens"
      }
    },
    "techniques": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/technique"
      }
    },
    "provocations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/provocation"
      }
    },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/preset"
      }
    },
    "reframes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reframe"
      }
    },
    "reframe_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reframe_set"
      }
    },
    "decompositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decomposition"
      }
    },
    "decomposition_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decomposition_set"
      }
    },
    "debates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/debate"
      }
    },
    "debate_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/debate_rule"
      }
    },
    "rubrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/rubric"
      }
    },
    "composition_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/pattern"
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "lens": {
      "type": "object",
      "required": [
        "id",
        "family",
        "name",
        "asks",
        "sees",
        "misses",
        "clashes",
        "delivers",
        "instruments"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "family": {
          "type": "string",
          "x-ref": "families"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "asks": {
          "type": "string",
          "minLength": 1
        },
        "sees": {
          "type": "string",
          "minLength": 1
        },
        "misses": {
          "type": "string",
          "minLength": 1
        },
        "clashes": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "lenses"
          }
        },
        "delivers": {
          "type": "string",
          "minLength": 1
        },
        "instruments": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "technique": {
      "type": "object",
      "required": [
        "id",
        "name",
        "how"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "how": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provocation": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "preset": {
      "type": "object",
      "required": [
        "id",
        "shape",
        "lenses",
        "deep_add",
        "rubric"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "shape": {
          "type": "string",
          "minLength": 1
        },
        "lenses": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "lenses"
          }
        },
        "deep_add": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "lenses"
          }
        },
        "rubric": {
          "type": "string",
          "x-ref": "rubrics"
        },
        "wildcard": {
          "type": "boolean"
        }
      }
    },
    "reframe": {
      "type": "object",
      "required": [
        "id",
        "name",
        "how"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "how": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reframe_set": {
      "type": "object",
      "required": [
        "id",
        "when",
        "reframes",
        "deep_add"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "reframes": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "reframes"
          }
        },
        "deep_add": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "reframes"
          }
        }
      }
    },
    "decomposition": {
      "type": "object",
      "required": [
        "id",
        "name",
        "how"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "how": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decomposition_set": {
      "type": "object",
      "required": [
        "id",
        "when",
        "decompositions",
        "deep_add"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "decompositions": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "decompositions"
          }
        },
        "deep_add": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "decompositions"
          }
        }
      }
    },
    "debate": {
      "type": "object",
      "required": [
        "id",
        "name",
        "how",
        "when",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "how": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "debate_rule": {
      "type": "object",
      "required": [
        "rule",
        "source"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rubric": {
      "type": "object",
      "required": [
        "use_for",
        "weights"
      ],
      "properties": {
        "use_for": {
          "type": "string",
          "minLength": 1
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "discipline",
        "use_when",
        "move",
        "receipt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "discipline": {
          "type": "string",
          "minLength": 1
        },
        "use_when": {
          "type": "string",
          "minLength": 1
        },
        "move": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pattern": {
      "type": "object",
      "required": [
        "id",
        "name",
        "problem",
        "solution",
        "models",
        "other_models"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "solution": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "array",
          "items": {
            "type": "string",
            "x-ref": "models"
          }
        },
        "other_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "id",
        "name",
        "verbs",
        "method",
        "instruments",
        "receipt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "instruments": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
